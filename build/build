#!/bin/bash

# Get the directory of the script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

# Change to the script's directory
cd "$SCRIPT_DIR"

# LINEAR -> Execute the Pandoc command
pandoc "../wiss-foto-kmb.md" \
-o "../wiss-foto-kmb.pdf" \
--from markdown-markdown_in_html_blocks+raw_html+grid_tables \
--template="../resources/info-manual.latex" \
--pdf-engine="lualatex" \
--citeproc \
--standalone \
--resource-path="../resources"\

# HTML -> Execute the Pandoc command
pandoc "../wiss-foto-kmb.md" \
-o "../wiss-foto-kmb.html" \
--citeproc \
--standalone \
--resource-path="../resources"\
